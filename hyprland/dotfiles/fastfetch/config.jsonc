{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	"type": "small",
        "padding": {
            "top": 3,
            "left": 1
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#960018"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#960018"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#960018"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#960018"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#960018"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#960018"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#960018"
        },
        {
            "type": "bios",
            "key": "│ ├󰘚",
            "keyColor": "#960018"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#960018"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#960018"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#34a089"
        },
        {
            "type": "command",
            "key": "│ ├",
            "text": "noctalia -v",
            "keyColor": "#34a089"
        },
        {
            "type": "lm",
            "key": "│ ├",
            "keyColor": "#34a089"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#34a089"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#34a089"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────Uptime / Age────────────────────┐"
        },
        {
            "type": "command",
            "key": "                   OS Age ",
            "keyColor": "#59000e",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "                   Uptime ",
            "keyColor": "#59000e"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break"
    ]
}
